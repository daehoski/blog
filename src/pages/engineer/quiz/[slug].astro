---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import LoginBenefitCard from '../../../components/LoginBenefitCard.astro';
import { allJipQuizData } from '../../../data/jip-quiz-data.js';
import '../../../styles/quiz.css';

// Slug Map is simplified for JIP since we don't need obscuring yet, but keeping structure for future
export function getStaticPaths() {
  return Object.keys(allJipQuizData).map(range => ({
    params: { slug: range }
  }));
}

const { slug } = Astro.params;
const range = slug;
const quizData = allJipQuizData[range] || [];

const getDisplayRange = (r) => {
  if (r.includes('년') && r.includes('회')) {
      return r.replace('년', '년 ').replace('회', '회 기출문제');
  }
  return r;
};

const title = `정보처리 산업기사 실전 대비 (${getDisplayRange(range)})`;
const description = `정보처리 산업기사 ${getDisplayRange(range)}를 실전처럼 풀어보고 오답 노트를 확인하세요.`;

// 전체 퀴즈 목록 (네비게이션용)
const allRanges = Object.keys(allJipQuizData).sort((a, b) => b.localeCompare(a));
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<div class="quiz-container">
				<nav class="quiz-top-nav">
					<a href="/engineer/" id="back-to-list" class="back-link">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="15 18 9 12 15 6"></polyline>
						</svg>
						목록으로
					</a>
				</nav>

				<header id="main-quiz-header" class="mobile-hidden" style="text-align: center; margin-bottom: 2rem;">
					<h1 style="font-size: 1.7rem; margin-bottom: 0.5rem; font-weight: 800; letter-spacing: -0.04em;">{title}</h1>
					<p style="color: #86868b; font-size: 0.95rem; font-weight: 500;">기출문제를 풀고 실력을 점검해 보세요.</p>
                    <div id="user-greeting" class="hidden" style="margin-top: 1.5rem; font-size: 0.95rem; color: #1d1d1f; font-weight: 600;">
                        안녕하세요, <span id="user-name"></span>님! 📚
                    </div>
				</header>

				{quizData.length > 0 ? (
                    <div id="quiz-wrapper">
                        <form id="quiz-form">
                            {quizData.map((quiz, index) => (
                                <article class="quiz-card" id={`quiz-${quiz.id}`} data-answer={JSON.stringify(quiz.answer)}>
                                    <div class="quiz-question-header">
                                        <span class="quiz-badge">Q{quiz.id}</span>
                                        <h2 class="quiz-question-text">{quiz.question}</h2>
                                    </div>
                                    {quiz.image && (
                                        <div class="quiz-image-container" style="margin-top: 1rem; margin-bottom: 1.5rem; text-align: center;">
                                            <img src={quiz.image} alt="문제 참조 이미지" style="max-width: 100%; max-height: 400px; border-radius: 8px; border: 1px solid #e5e7eb; box-shadow: 0 2px 12px rgba(0,0,0,0.05);" />
                                        </div>
                                    )}

                                    <div class="quiz-options">
                                        {quiz.options.map((option, optIndex) => (
                                            <label class="quiz-option" for={`q${quiz.id}-opt${optIndex}`}>
                                                <input 
                                                    type={Array.isArray(quiz.answer) ? "checkbox" : "radio"} 
                                                    name={`q${quiz.id}`} 
                                                    id={`q${quiz.id}-opt${optIndex}`} 
                                                    value={optIndex}
                                                />
                                                <span class="quiz-option-text">{option}</span>
                                            </label>
                                        ))}
                                    </div>

                                    <button type="button" class="quiz-btn grade-btn" data-quiz-id={quiz.id}>
                                        정답 확인 및 해설
                                    </button>

                                    <div class="quiz-result-area hidden" id={`result-${quiz.id}`}>
                                        <div class="quiz-explanation">
                                            <div class="quiz-explanation-title">
                                                <span>📖 해설</span>
                                            </div>
                                            <p class="explanation-text">{quiz.explanation}</p>
                                        </div>
                                    </div>
                                </article>
                            ))}
                        </form>
                    </div>
                ) : (
                    <div style="text-align: center; padding: 4rem; background: white; border-radius: 12px; box-shadow: 0 4px 24px rgba(0,0,0,0.04);">
                        <p style="font-size: 1.25rem; color: #666;">데이터를 준비 중입니다. 잠시만 기다려 주세요! 🚧</p>
                    </div>
                )}

				<div class="quiz-summary-card">
					<button id="show-summary-btn" class="quiz-btn summary-card-btn">
						최종 결과 및 오답 노트 보기
					</button>

					<div id="summary-result" class="hidden">
						<div class="quiz-score-circle">
							<span id="final-score">0</span>
							<span class="quiz-score-text">/ {quizData.length}</span>
						</div>
						<p id="score-message" style="font-weight: 700; font-size: 1.1rem; margin-bottom: 2rem;"></p>
						
						<div class="quiz-wrong-review" id="wrong-answer-note">
							<h3 style="border-bottom: 2px solid #e5e7eb; padding-bottom: 0.5rem; margin-bottom: 1rem;">📝 오답 노트</h3>
							<div id="wrong-list-container"></div>
						</div>

                        <LoginBenefitCard />
					</div>
				</div>

				<div class="quiz-nav-section" style="margin-top: 3rem; padding-top: 1.5rem; border-top: 2px solid #e5e7eb;">
					<h3 style="margin-bottom: 1rem; text-align: center; font-size: 1rem; color: #374151;">🎯 다른 회차 풀어보기</h3>
					<div class="quiz-nav-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 0.75rem;">
						{allRanges.map((r) => (
							<a 
								href={`/engineer/quiz/${r}/`} 
								class={`quiz-nav-item ${r === range ? 'active' : ''}`}
								style={`
									display: block;
									padding: 0.6rem;
									text-align: center;
									background: ${r === range ? '#2563eb' : 'white'};
									color: ${r === range ? 'white' : '#4b5563'};
									border: 1px solid ${r === range ? '#2563eb' : '#e5e7eb'};
									border-radius: 6px;
									text-decoration: none;
									font-size: 0.85rem;
									font-weight: 500;
									transition: all 0.2s;
								`}
							>
								{getDisplayRange(r)}
							</a>
						))}
					</div>
				</div>
			</div>

            <div id="exit-modal" class="modal-overlay hidden">
                <div class="modal-content glass">
                    <h3>퀴즈를 중단하시겠습니까?</h3>
                    <p>지금까지의 진행 상황이 저장되지 않을 수 있습니다.</p>
                    <div class="modal-buttons">
                        <button id="modal-continue" class="modal-btn secondary">계속 풀기</button>
                        <button id="modal-exit" class="modal-btn primary">나가기</button>
                    </div>
                </div>
            </div>

            <div id="quiz-data-store" data-quiz={JSON.stringify(quizData)} class="hidden"></div>
		</main>
		<Footer />

		<script>
            import { supabase } from '../../../lib/supabase.js';

			document.addEventListener('DOMContentLoaded', async () => {
                let currentUser = null;
                if (supabase) {
                    const { data: { session } } = await supabase.auth.getSession();
                    if (session) {
                        currentUser = session.user;
                        const name = currentUser.user_metadata?.full_name || currentUser.email?.split('@')[0] || 'User';
                        document.getElementById('user-name').textContent = name;
                        document.getElementById('user-greeting').classList.remove('hidden');
                    }
                }

				const gradeBtns = document.querySelectorAll('.grade-btn');
				const showSummaryBtn = document.getElementById('show-summary-btn');
				const summaryResult = document.getElementById('summary-result');
				const finalScoreSpan = document.getElementById('final-score');
				const wrongListContainer = document.getElementById('wrong-list-container');
				const scoreMessage = document.getElementById('score-message');
                const quizDataElement = document.getElementById('quiz-data-store');
                const rawQuizData = quizDataElement ? quizDataElement.getAttribute('data-quiz') : '[]';
                const quizData = JSON.parse(rawQuizData);

				let score = 0;
				let wrongAnswers = [];

				gradeBtns.forEach(btn => {
					btn.addEventListener('click', (e) => {
						const quizId = parseInt(e.target.getAttribute('data-quiz-id'));
						const quizCard = document.getElementById(`quiz-${quizId}`);
						const rawAnswer = quizCard.getAttribute('data-answer');
						let correctAnswers = JSON.parse(rawAnswer);
						
						if (!Array.isArray(correctAnswers)) correctAnswers = [correctAnswers];

						const inputs = quizCard.querySelectorAll(`input[name="q${quizId}"]`);
						const selectedVals = Array.from(inputs).filter(i => i.checked).map(i => parseInt(i.value));

						if (selectedVals.length === 0) {
							alert("정답을 선택해주세요.");
							return;
						}

						const isCorrect = correctAnswers.every(v => selectedVals.includes(v)) && correctAnswers.length === selectedVals.length;

						inputs.forEach((input, idx) => {
							input.disabled = true;
							const label = input.closest('label');
							if (correctAnswers.includes(idx)) {
								label.classList.add('correct');
							} else if (input.checked && !correctAnswers.includes(idx)) {
								label.classList.add('wrong');
							}
						});

						if (isCorrect) {
							score++;
							e.target.textContent = "정답입니다! 🎉";
							e.target.style.backgroundColor = "#22c55e";
						} else {
							e.target.textContent = "오답입니다.";
							e.target.style.backgroundColor = "#ef4444";
							wrongAnswers.push(quizId);
						}

						document.getElementById(`result-${quizId}`).classList.remove('hidden');
						e.target.disabled = true;
					});
				});

				showSummaryBtn.addEventListener('click', () => {
					summaryResult.classList.remove('hidden');
					finalScoreSpan.textContent = score;
					showSummaryBtn.style.display = 'none';

					const ratio = score / quizData.length;
					if (ratio === 1) scoreMessage.textContent = "완벽합니다! 백점 만점! 🏆";
					else if (ratio >= 0.8) scoreMessage.textContent = "훌륭합니다! 조금만 더 다듬으면 완벽해요. 👍";
					else if (ratio >= 0.5) scoreMessage.textContent = "절반 이상 맞추셨군요! 오답 노트를 확인해 보세요. 😊";
					else scoreMessage.textContent = "오답 노트를 통해 다시 한번 복습해 봅시다! 💪";

					if (wrongAnswers.length > 0) {
						let wrongHtml = '';
						wrongAnswers.forEach(id => {
							const q = quizData.find(x => x.id === id);
							if (q) {
								let correctText = Array.isArray(q.answer) 
									? q.answer.map(a => q.options[a]).join(', ')
									: q.options[q.answer];

								wrongHtml += `
									<div style="background: #fef2f2; border-left: 4px solid #ef4444; padding: 1rem; margin-bottom: 1rem; border-radius: 0 8px 8px 0;">
										<p style="font-weight: bold; margin-bottom: 0.5rem; font-size: 0.95rem;">Q${q.id}. ${q.question}</p>
										<p style="color: #ef4444; font-size: 0.9rem; margin-bottom: 0.5rem;"><strong>정답:</strong> ${correctText}</p>
										<p style="color: #4b5563; font-size: 0.85rem; line-height: 1.5;"><strong>해설:</strong> ${q.explanation}</p>
									</div>
								`;
							}
						});
						wrongListContainer.innerHTML = wrongHtml;
					} else {
						wrongListContainer.innerHTML = '<p style="color: #10b981; font-weight: bold;">틀린 문제가 없습니다! 완벽해요 🎉</p>';
					}
                    
                    window.scrollTo({
                        top: summaryResult.offsetTop - 100,
                        behavior: 'smooth'
                    });
				});

                // Exit Modal Logic
                const backBtn = document.getElementById('back-to-list');
                const modal = document.getElementById('exit-modal');
                const btnContinue = document.getElementById('modal-continue');
                const btnExit = document.getElementById('modal-exit');
                let isLeavingIntentionally = false;

                backBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    modal.classList.remove('hidden');
                });

                btnContinue.addEventListener('click', () => {
                    modal.classList.add('hidden');
                });

                btnExit.addEventListener('click', () => {
                    isLeavingIntentionally = true;
                    window.location.href = '/engineer/';
                });

                // Prompt user before leaving if they haven't seen the summary
                window.addEventListener('beforeunload', (e) => {
                    if (!isLeavingIntentionally && showSummaryBtn.style.display !== 'none' && score > 0) {
                        e.preventDefault();
                        e.returnValue = '';
                    }
                });
			});
		</script>
	</body>
</html>
