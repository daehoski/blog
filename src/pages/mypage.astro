---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { allQuizData } from '../data/all-quiz-data.js';
import { quizSlugMap } from '../lib/utils.js';
---

<!doctype html>
<html lang="ko">
<head>
    <BaseHead title={`마이페이지 | ${SITE_TITLE}`} description="나의 학습 현황과 실시간 약점 분석 레이더를 확인하세요." />
    <style>
        main { max-width: 1100px; margin: 0 auto; padding: 4rem 1.5rem; }
        .dashboard-grid { 
            display: grid; 
            grid-template-columns: repeat(3, 1fr); 
            gap: 1.5rem; 
            margin-top: 2.5rem; 
        }
        .stats-card { 
            background: white; 
            border-radius: 28px; 
            padding: 2rem; 
            box-shadow: 0 4px 24px rgba(0,0,0,0.04); 
            display: flex; 
            flex-direction: column; 
            justify-content: space-between;
            min-height: 320px;
        }
        .stats-card h3 { font-size: 1rem; font-weight: 700; color: #1d1d1f; margin-bottom: 1.5rem; }
        .full-width { grid-column: 1 / -1; }
        
        /* Achievement Ring */
        .ring-container { position: relative; display: flex; justify-content: center; align-items: center; }
        .ring-text { position: absolute; text-align: center; display: flex; flex-direction: column; }
        .ring-percent { font-size: 1.8rem; font-weight: 800; color: #1d1d1f; }
        .ring-label { font-size: 0.75rem; color: #86868b; font-weight: 600; margin-top: 2px; }
        
        /* Stats Hints */
        .stats-hint { font-size: 0.85rem; color: #86868b; margin-top: 1rem; font-weight: 600; text-align: center; }

        /* Weekly Bars */
        .activity-bars { display: flex; align-items: flex-end; justify-content: space-between; height: 140px; gap: 8px; padding: 0 0.5rem; }
        .bar-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8px; }
        .bar-fill { width: 100%; background: #0051c3; border-radius: 6px 6px 2px 2px; min-height: 4px; transition: height 1s cubic-bezier(0.4, 0, 0.2, 1); }
        .bar-label { font-size: 0.7rem; font-weight: 700; color: #86868b; }

        /* Radar Chart */
        .radar-container { position: relative; display: flex; flex-direction: column; align-items: center; }
        .radar-legend { margin-top: 0.5rem; display: flex; gap: 1rem; font-size: 0.75rem; font-weight: 600; color: #86868b; }
        .legend-item { display: flex; align-items: center; gap: 0.3rem; }
        .legend-item .dot { width: 8px; height: 8px; border-radius: 50%; }

        /* Lists */
        .wrong-list-container { margin-top: 2.5rem; display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
        .list-card { background: white; border-radius: 28px; padding: 2rem; box-shadow: 0 4px 24px rgba(0,0,0,0.04); }
        .list-card h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem; }
        .wrong-item { display: flex; justify-content: space-between; align-items: center; padding: 0.85rem 0; border-bottom: 1px solid rgba(0, 0, 0, 0.05); }
        .wrong-link { text-decoration: none; color: #1d1d1f; font-weight: 500; font-size: 0.95rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 75%; }
        .wrong-link:hover { color: #0051c3; text-decoration: underline; }

        .delete-btn { background: transparent; color: #ff3b30; border: 1px solid rgba(255, 59, 48, 0.2); padding: 0.8rem 1.5rem; border-radius: 99px; font-size: 0.85rem; font-weight: 700; cursor: pointer; transition: all 0.2s; margin-top: 2rem; }
        .delete-btn:hover { background: #ff3b30; color: white; }

        @media (max-width: 1024px) { .dashboard-grid { grid-template-columns: 1fr 1fr; } .wrong-list-container { grid-template-columns: 1fr; } }
        @media (max-width: 768px) { .dashboard-grid { grid-template-columns: 1fr; } main { padding-top: 2rem; } }
    </style>
</head>
<body>
    <Header />
    <main>
        <section id="welcome-section" style="margin-bottom: 3rem;">
            <h1 id="user-greeting" style="font-size: clamp(2.2rem, 5vw, 3.2rem); font-weight: 800; letter-spacing: -0.04em; color: #1d1d1f;">학습 현황 분석 중...</h1>
            <div id="coaching-analysis" style="background: #f5f5f7; border-radius: 20px; padding: 1.5rem; margin-top: 1.5rem; font-weight: 600; line-height: 1.6; color: #1d1d1f; font-size: 1.05rem;">
                데이터를 불러오고 있습니다...
            </div>
        </section>

        <div class="dashboard-grid">
            <!-- Achievement Ring -->
            <div class="stats-card">
                <h3>오늘의 학습 달성도</h3>
                <div class="ring-container">
                    <svg width="160" height="160" viewBox="0 0 140 140">
                        <circle cx="70" cy="70" r="60" stroke="#f2f2f7" stroke-width="12" fill="none"></circle>
                        <circle cx="70" cy="70" r="60" stroke="#0051c3" stroke-width="12" fill="none" 
                            stroke-dasharray="377" stroke-dashoffset="377" stroke-linecap="round" id="goal-ring" style="transition: stroke-dashoffset 1s ease-out;"></circle>
                    </svg>
                    <div class="ring-text">
                        <span class="ring-percent" id="ring-percent">0%</span>
                        <span class="ring-label" id="streak-label">0일 연속</span>
                    </div>
                </div>
                <p class="stats-hint" id="goal-text">목표 30문제 달성 중</p>
            </div>

            <!-- Radar Analytics -->
            <div class="stats-card">
                <h3>약점 분석 (Radar)</h3>
                <div class="radar-container">
                    <svg id="radar-chart" width="220" height="220" viewBox="0 0 300 300"></svg>
                    <div class="radar-legend">
                        <div class="legend-item"><span class="dot" style="background: rgba(0, 81, 195, 0.45); border: 1px solid #0051c3;"></span>성취도</div>
                    </div>
                </div>
                <p class="stats-hint" id="radar-hint">데이터 분석 중...</p>
            </div>

            <!-- Weekly Activity -->
            <div class="stats-card">
                <h3>주간 학습 활동</h3>
                <div class="activity-bars" id="activity-bars">
                    <!-- JS -->
                </div>
                <div class="bar-labels" style="display: flex; justify-content: space-between; margin-top: 1rem; padding: 0 0.5rem; font-size: 0.7rem; font-weight: 700; color: #86868b;">
                    <span>일</span><span>월</span><span>화</span><span>수</span><span>목</span><span>금</span><span>토</span>
                </div>
            </div>
        </div>

        <div class="wrong-list-container">
            <div class="list-card">
                <h3>📝 최신 토익 오답 리뷰</h3>
                <div id="toeic-wrong-list"></div>
            </div>
            <div class="list-card">
                <h3>📝 AWS 오답 아카이브</h3>
                <div id="aws-wrong-list"></div>
            </div>
        </div>

        <div style="text-align: center; margin-top: 4rem;">
            <button id="delete-account-btn" class="delete-btn">계정 데이터 초기화 및 탈퇴</button>
        </div>
    </main>
    <Footer />

    <script>
        import { supabase } from '../lib/supabase.js';
        import { allQuizData } from '../data/all-quiz-data.js';
        import { quizSlugMap } from '../lib/utils.js';

        async function initMyPage() {
            const { data: { session } } = await supabase.auth.getSession();
            if (!session) { window.location.href = '/'; return; }

            const user = session.user;
            const name = user.user_metadata?.full_name || user.email?.split('@')[0];
            document.getElementById('user-greeting').textContent = `${name}님, 환영합니다! 👋`;

            // 1. Fetch Data
            const { data: toeicProgress } = await supabase.from('toeic_progress').select('*').eq('user_id', user.id);
            const { data: awsWrong } = await supabase.from('wrong_answers').select('*').eq('user_id', user.id);

            const validToeic = toeicProgress || [];
            const validAws = awsWrong || [];

            // 2. Goal Ring
            const dailyGoal = 30;
            const today = new Date().setHours(0,0,0,0);
            const todayCount = validToeic.filter(r => new Date(r.updated_at).getTime() >= today).length;
            const goalRatio = Math.min(todayCount / dailyGoal, 1);
            const dashOffset = 377 * (1 - goalRatio);
            document.getElementById('goal-ring').style.strokeDashoffset = dashOffset;
            document.getElementById('ring-percent').textContent = `${Math.round(goalRatio * 100)}%`;
            document.getElementById('goal-text').textContent = todayCount >= dailyGoal ? "🔥 오늘의 목표 달성!" : `목표까지 ${dailyGoal - todayCount}항 남음`;

            // 3. Streak
            const localToday = new Date().toLocaleDateString();
            const lastStudy = localStorage.getItem('last_study_date');
            let streak = parseInt(localStorage.getItem('study_streak') || '0');
            if (lastStudy !== localToday) {
                if (lastStudy === new Date(Date.now() - 86400000).toLocaleDateString()) streak++;
                else streak = 1;
                localStorage.setItem('study_streak', streak);
                localStorage.setItem('last_study_date', localToday);
            }
            document.getElementById('streak-label').textContent = `${streak}일 연속`;

            // 4. Radar Chart
            const categories = ["어휘", "동사구", "품사", "접속/전치", "구조/기타"];
            const scores = { "어휘": [], "동사구": [], "품사": [], "접속/전치": [], "구조/기타": [] };
            validToeic.forEach(r => {
                let cat = "어휘";
                if (r.toeic_id.startsWith('g-')) {
                    const ch = r.toeic_id.split('-')[1];
                    if (ch === '0') cat = "품사";
                    else if (['1','2','3','4'].includes(ch)) cat = "동사구";
                    else if (['6','9'].includes(ch)) cat = "접속/전치";
                    else cat = "구조/기타";
                }
                scores[cat].push(r.is_correct ? 1 : 0);
            });
            const radarValues = categories.map(c => {
                const s = scores[c];
                if (s.length === 0) return 0.2;
                return 0.2 + ((s.reduce((a,b)=>a+b,0)/s.length) * 0.75);
            });
            renderRadar(radarValues, categories);
            const weakIdx = radarValues.indexOf(Math.min(...radarValues));
            document.getElementById('radar-hint').textContent = `${categories[weakIdx]} 파트 보강이 필요합니다.`;

            // 5. Weekly Bars
            const bars = document.getElementById('activity-bars');
            const weekStats = Array(7).fill(0);
            for(let i=0; i<7; i++) {
                const d = new Date(); d.setDate(d.getDate() - (6-i));
                const s = d.setHours(0,0,0,0); const e = d.setHours(23,59,59,999);
                weekStats[i] = validToeic.filter(r => { const t = new Date(r.updated_at).getTime(); return t>=s && t<=e; }).length;
            }
            const maxVal = Math.max(...weekStats, 5);
            bars.innerHTML = weekStats.map(count => `<div class="bar-item"><div class="bar-fill" style="height:${(count/maxVal)*100}%"></div></div>`).join('');

            // 6. Lists
            const toeicList = document.getElementById('toeic-wrong-list');
            toeicList.innerHTML = validToeic.filter(r => !r.is_correct).slice(0, 5).map(r => `
                <div class="wrong-item">
                    <a href="/toeic/phrases/?mode=review" class="wrong-link">${r.toeic_id.startsWith('g-') ? '[문법]' : '[어휘]'} ${r.toeic_id}</a>
                    <span style="font-size:0.75rem; color:#86868b;">${new Date(r.updated_at).toLocaleDateString()}</span>
                </div>
            `).join('') || '<p style="color:#86868b;">오답이 없습니다.</p>';

            // 7. Coaching Analysis
            const weakCategory = categories[weakIdx];
            document.getElementById('coaching-analysis').innerHTML = `현재 ${name}님은 **[${weakCategory}]** 파트에서 가장 많은 오답이 발생하고 있습니다. 보관소에서 해당 영역의 어휘를 다시 복습해보세요!`;

            // 8. Delete
            document.getElementById('delete-account-btn').onclick = async () => {
                if(confirm("정말 탈퇴하시겠습니까? 데이터는 복구되지 않습니다.")) {
                    await supabase.from('toeic_progress').delete().eq('user_id', user.id);
                    await supabase.auth.signOut();
                    window.location.href = '/';
                }
            };
        }

        function renderRadar(values, cats) {
            const svg = document.getElementById('radar-chart');
            const centerX = 150, centerY = 150, radius = 100, step = (Math.PI*2)/cats.length;
            let bg = '', axes = '', pts = '', poly = '';
            for(let i=1; i<=5; i++) {
                let p = ''; const r = (radius/5)*i;
                for(let j=0; j<=cats.length; j++) { const a = j*step - Math.PI/2; p += `${centerX+Math.cos(a)*r},${centerY+Math.sin(a)*r} `; }
                bg += `<polygon points="${p}" fill="none" stroke="#f0f0f5" stroke-width="1" />`;
            }
            cats.forEach((c, i) => {
                const a = i*step - Math.PI/2;
                const x = centerX+Math.cos(a)*radius, y = centerY+Math.sin(a)*radius;
                const lx = centerX+Math.cos(a)*130, ly = centerY+Math.sin(a)*120;
                axes += `<line x1="${centerX}" y1="${centerY}" x2="${x}" y2="${y}" stroke="#f0f0f5" />`;
                axes += `<text x="${lx}" y="${ly}" text-anchor="middle" font-size="11" font-weight="700" fill="#1d1d1f">${c}</text>`;
                const rv = values[i]*radius;
                pts += `${centerX+Math.cos(a)*rv},${centerY+Math.sin(a)*rv} `;
            });
            poly = `<polygon points="${pts}" fill="rgba(0, 81, 195, 0.2)" stroke="#0051c3" stroke-width="2.5" />`;
            svg.innerHTML = bg + axes + poly;
        }

        initMyPage();
    </script>
</body>
</html>
