---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="ko">
<head>
    <BaseHead title={`ETS VOCA 30일 완성 | ${SITE_TITLE}`} description="ETS 기출 VOCA 30일 완성 챌린지. 나의 학습 현황을 확인하세요." />
    <style>
        body { background: #f5f5f7; }
        main { max-width: 1100px; margin: 0 auto; padding: 4rem 1.5rem; }
        
        .hero-section { text-align: center; margin-bottom: 4rem; }
        .hero-section h1 { font-size: 3rem; font-weight: 800; color: #1d1d1f; letter-spacing: -0.05em; margin-bottom: 1rem; }
        .hero-section p { color: #86868b; font-size: 1.15rem; font-weight: 500; }
        
        .progress-overview { background: white; border-radius: 28px; padding: 2rem; margin-bottom: 3rem; box-shadow: 0 4px 24px rgba(0,0,0,0.04); display: flex; align-items: center; gap: 2rem; }
        .overall-progress { width: 100px; height: 100px; position: relative; flex-shrink: 0; }
        .progress-text { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-weight: 800; font-size: 1.2rem; }
        .progress-info { flex: 1; }
        .progress-info h2 { font-size: 1.2rem; font-weight: 700; margin-bottom: 0.5rem; }
        
        .day-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 1.5rem; }
        .day-card { background: white; border-radius: 22px; padding: 1.5rem; border: 1px solid rgba(0,0,0,0.03); text-decoration: none; color: inherit; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); display: flex; flex-direction: column; gap: 0.5rem; position: relative; overflow: hidden; }
        .day-card:hover { transform: translateY(-8px); box-shadow: 0 12px 32px rgba(0,0,0,0.08); border-color: #0051c3; }
        
        .day-num { font-size: 0.8rem; font-weight: 800; color: #0051c3; opacity: 0.6; }
        .day-title { font-size: 1.3rem; font-weight: 800; color: #1d1d1f; }
        .day-count { font-size: 0.85rem; font-weight: 600; color: #86868b; }
        
        .day-card.locked { opacity: 0.5; filter: grayscale(1); cursor: not-allowed; }
        .day-card.locked:hover { transform: none; box-shadow: none; border-color: transparent; }
        
        .entry-link { position: absolute; bottom: 1.5rem; right: 1.5rem; background: #f5f5f7; padding: 0.5rem 1rem; border-radius: 99px; font-size: 0.8rem; font-weight: 700; text-decoration: none; color: #1d1d1f; transition: background 0.2s; }
        .entry-link:hover { background: #e5e5ea; }

        @media (max-width: 600px) { .day-grid { grid-template-columns: 1fr 1fr; } }
    </style>
</head>
<body>
    <Header />
    <main>
        <section class="hero-section">
            <h1>ETS 기출 VOCA 30일 완성</h1>
            <p>나만의 타이핑 공부법으로 완성하는 30일 데이터 세트</p>
        </section>

        <div class="progress-overview">
            <div class="overall-progress">
                <svg viewBox="0 0 36 36" style="width:100%; height:100%;">
                    <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#f2f2f7" stroke-width="3" />
                    <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#0051c3" stroke-width="3" stroke-dasharray="0, 100" id="overall-dash" stroke-linecap="round" style="transition: stroke-dasharray 1s ease-out;" />
                </svg>
                <div class="progress-text" id="overall-pct">0%</div>
            </div>
            <div class="progress-info">
                <h2 id="progress-summary">학습을 시작해 보세요!</h2>
                <p style="font-size: 0.9rem; color: #86868b; font-weight: 500;">현재까지 <span id="total-words-count">0</span>개의 단어가 수집되었습니다.</p>
                <a href="/toeic/studio/" class="entry-link" style="position: static; margin-top: 1rem; display: inline-block;">+ 단어 추가하러 가기</a>
            </div>
        </div>

        <div class="day-grid" id="day-grid">
            <!-- JS -->
        </div>
    </main>
    <Footer />

    <script>
        import { supabase } from '../../lib/supabase.js';

        async function initDashboard() {
            const { data: { session } } = await supabase.auth.getSession();
            if (!session) { window.location.href = '/'; return; }

            const { data } = await supabase
                .from('ets_voca')
                .select('day')
                .eq('user_id', session.user.id);
            
            const stats = {};
            if (data) {
                data.forEach(r => stats[r.day] = (stats[r.day] || 0) + 1);
                const totalWords = data.length;
                document.getElementById('total-words-count').textContent = totalWords;
                
                const dayCountFilled = Object.keys(stats).length;
                const overallPct = Math.round((dayCountFilled / 30) * 100);
                document.getElementById('overall-pct').textContent = overallPct + '%';
                document.getElementById('overall-dash').setAttribute('stroke-dasharray', `${overallPct}, 100`);
                document.getElementById('progress-summary').textContent = dayCountFilled >= 30 ? "🔥 30일 완성 달성!" : `${dayCountFilled}일차 학습 데이터 수집 중`;
            }

            renderGrid(stats);
        }

        function renderGrid(stats) {
            const grid = document.getElementById('day-grid');
            let html = '';
            for (let i = 1; i <= 30; i++) {
                const count = stats[i] || 0;
                const isLocked = count === 0;
                
                html += `
                    <a href="${isLocked ? '#' : `/toeic/phrases/?mode=ets&day=${i}`}" class="day-card ${isLocked ? 'locked' : ''}">
                        <span class="day-num">DAY ${i < 10 ? '0'+i : i}</span>
                        <span class="day-title">${i}일차</span>
                        <span class="day-count">${count} items</span>
                        ${isLocked ? '<span style="font-size: 0.7rem; font-weight: 700; color: #86868b; margin-top: 0.5rem;">입력 대기 중</span>' : ''}
                    </a>
                `;
            }
            grid.innerHTML = html;
        }

        initDashboard();
    </script>
</body>
</html>
